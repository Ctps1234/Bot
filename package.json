{
  "name": "oficinavolt",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de gestão para oficina elétrica automotiva",
  "scripts": {
    "predev": "node scripts/setup.mjs",
    "dev": "node scripts/run-next.mjs dev -H 0.0.0.0 -p 3000",
    "prebuild": "node scripts/setup.mjs",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start -H 0.0.0.0 -p 3000",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:fresh": "tsx prisma/seed.ts --fresh",
    "db:no-demo": "tsx prisma/seed.ts --no-demo"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "jose": "6.1.0",
    "lucide-react": "0.545.0",
    "next": "15.5.28",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.9",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.5"
  }
}
