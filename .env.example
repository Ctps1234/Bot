# Banco de dados (SQLite). O arquivo fica em /data na raiz do projeto.
DATABASE_URL="file:./data/oficina.db"

# Segredo usado para assinar o cookie de sessão. Troque em produção!
AUTH_SECRET="troque-este-segredo-em-producao"

# Nome do app exibido no login e no menu (o nome da oficina em si fica em Configurações)
NEXT_PUBLIC_APP_NAME="OficinaVolt"
